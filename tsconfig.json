{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": ["ESNext", "DOM", "dom.iterable"],
    "moduleResolution": "bundler",
    "strict": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": false,
    "types": ["vite/client"],
    "paths": {
      "zui-dev": ["./dev"],
      "@zui/virtualize/virtualizer": ["./lib/virtualize/src/virtualizer.ts"],
      "@zui/vtable/plugins/*": ["./lib/vtable/src/plugins/*"],
      "@zui/*": ["./lib/*"]
    }
  },
  "include": [
    "src",
    "config",
    "dev/src/dev.ts",
    "exts/*/dev.ts"
  ],
  "exclude": [
    "public"
  ]
}
