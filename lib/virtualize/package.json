{
    "name": "@zui/virtualize",
    "description": "TanStack Virtual adapters and virtual lists for ZUI and Preact",
    "version": "0.0.1",
    "keywords": ["zui:component"],
    "main": "src/main.ts",
    "exports": {
        ".": "./src/main.ts",
        "./react": "./src/main-react.ts",
        "./virtualizer": "./src/virtualizer.ts"
    },
    "files": [
        "./src/**/*"
    ],
    "dependencies": {
        "@tanstack/virtual-core": "3.17.9",
        "@zui/core": "workspace:*",
        "@zui/utilities": "workspace:*",
        "preact": "^10.27.2"
    },
    "devDependencies": {
        "@zui/button": "workspace:*",
        "zui-dev": "workspace:*"
    },
    "zui": {
        "type": "component",
        "displayName": "虚拟渲染",
        "contributes": {
            "css": ["class"],
            "js": ["class", "method", "component"]
        }
    }
}
