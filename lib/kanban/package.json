{
    "name": "@zui/kanban",
    "description": "ZUI Kanban",
    "version": "3.1.0",
    "keywords": [
        "js",
        "cs",
        "zui:js-ui"
    ],
    "main": "src/main.ts",
    "module": "src/main.ts",
    "browser": "src/main.ts",
    "exports": {
        ".": "./src/main.ts",
        "./css": "./src/main-css.ts",
        "./react": "./src/main-react.ts"
    },
    "dependencies": {
        "@zui/core": "workspace:^3.1.0",
        "@zui/helpers": "workspace:^3.1.0",
        "@zui/common-list": "workspace:^3.1.0",
        "@zui/scrollbar": "workspace:^3.1.0",
        "@zui/menu": "workspace:^3.1.0",
        "@zui/css-icons": "workspace:^3.1.0",
        "@zui/cards": "workspace:^3.1.0",
        "@zui/list": "workspace:^3.1.0",
        "@zui/toolbar": "workspace:^3.1.0",
        "@zui/dnd": "workspace:^3.1.0"
    },
    "files": [
        "./src/**/*"
    ],
    "devDependencies": {
        "@zui/button": "workspace:^3.1.0",
        "@zui/checkbox": "workspace:^3.1.0",
        "@zui/dropdown": "workspace:^3.1.0",
        "zui-dev": "workspace:^3.1.0",
        "@zui/icons": "workspace:^3.1.0"
    },
    "zui": {
        "type": "js-ui",
        "displayName": "看板",
        "contributes": {
            "css": [
                "class",
                "var"
            ],
            "js": [
                "component"
            ]
        }
    }
