{
    "name": "@zui/responsive-nav",
    "version": "3.1.0",
    "main": "src/main.ts",
    "browser": "src/main.ts",
    "keywords": [
        "css",
        "js",
        "zui:component"
    ],
    "files": [
        "./src/**/*"
    ],
    "exports": {
        ".": "./src/main.ts"
    },
    "devDependencies": {
        "@zui/base": "workspace:*",
        "@zui/utilities": "workspace:*",
        "@zui/button": "workspace:^3.1.0",
        "@zui/css-icons": "workspace:^3.1.0",
        "@zui/form-control": "workspace:^3.1.0",
        "@zui/menu": "workspace:^3.1.0"
    },
    "dependencies": {
        "@zui/core": "workspace:^3.1.0",
        "@zui/nav": "workspace:^3.1.0",
        "@zui/dropdown": "workspace:^3.1.0"
    },
    "zui": {
        "type": "component",
        "displayName": "自适应导航",
        "contributes": {
            "css": ["class", "var"],
            "js": ["component"]
        }
    }
}
