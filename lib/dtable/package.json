{
    "name": "@zui/dtable",
    "description": "ZUI datatable",
    "version": "3.1.0",
    "keywords": [
        "js",
        "cs",
        "zui:js-ui"
    ],
    "main": "src/main.ts",
    "module": "src/main.ts",
    "browser": "src/main.ts",
    "dependencies": {
        "@zui/avatar": "workspace:^3.1.0",
        "@zui/list": "workspace:^3.1.0",
        "@zui/core": "workspace:^3.1.0",
        "@zui/helpers": "workspace:^3.1.0",
        "@zui/scrollbar": "workspace:^3.1.0",
        "@zui/store": "workspace:^3.1.0",
        "@zui/checkbox": "workspace:^3.1.0",
        "@zui/contextmenu": "workspace:^3.1.0",
        "@zui/menu": "workspace:^3.1.0",
        "@zui/css-icons": "workspace:^3.1.0",
        "@zui/toolbar": "workspace:^3.1.0",
        "@zui/progress": "workspace:^3.1.0",
        "@zui/progress-circle": "workspace:^3.1.0",
        "@zui/pager": "workspace:^3.1.0"
