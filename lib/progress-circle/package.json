{
    "name": "@zui/progress-circle",
    "description": "ZUI progress-circle",
    "version": "3.1.0",
    "keywords": ["js", "zui:control"],
    "main": "src/main.ts",
    "module": "src/main.ts",
    "files": [
        "./src/**/*"
    ],
    "exports": {
      ".": "./src/main.ts",
      "./react": "./src/main-react.ts"
    },
    "dependencies": {
        "@zui/core": "workspace:*"
    },
    "devDependencies": {
        "zui-dev": "workspace:*"
    },
    "zui": {
        "type": "control",
        "displayName": "环形进度条",
        "contributes": {
            "js": ["component"]
        }
    }
}
