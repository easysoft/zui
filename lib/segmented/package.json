{
    "name": "@zui/segmented",
    "version": "0.0.1",
    "description": "ZUI segmented single-selection control",
    "main": "src/main.ts",
    "files": ["./src/**/*"],
    "keywords": ["control", "radio", "segmented", "zui:control"],
    "exports": {
        ".": "./src/main.ts",
        "./react": "./src/main-react.ts"
    },
    "dependencies": {
        "@zui/core": "workspace:*",
        "preact": "^10.27.2"
    },
    "devDependencies": {
        "@zui/base": "workspace:*",
        "@zui/button": "workspace:*",
        "@zui/css-icons": "workspace:*",
        "@zui/form-builder": "workspace:*",
        "@zui/utilities": "workspace:*",
        "zui-dev": "workspace:*"
    },
    "zui": {
        "type": "control",
        "displayName": "分段选择器",
        "contributes": {
            "css": ["class", "var"],
            "js": ["class", "component"]
        }
    }
}
