{
    "name": "@zui/scrollbar",
    "version": "3.1.0",
    "main": "src/main.ts",
    "browser": "src/main.ts",
    "keywords": [
        "css",
        "js",
        "zui:control"
    ],
    "files": [
        "./src/**/*"
    ],
    "exports": {
        ".": "./src/main.ts",
        "./css": "./src/main-css.ts",
        "./react": "./src/main-react.ts"
    },
    "devDependencies": {
        "@zui/base": "workspace:*",
        "@zui/utilities": "workspace:*",
        "zui-dev": "workspace:*"
    },
    "dependencies": {
        "@zui/core": "workspace:^3.1.0"
    },
    "zui": {
        "type": "control",
        "displayName": "滚动条",
        "contributes": {
            "css": ["class", "var"],
            "js": ["component"]
        }
    }
}
