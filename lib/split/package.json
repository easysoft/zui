{
    "name": "@zui/split",
    "description": "split.js plugin from https://split.js.org/",
    "version": "3.1.0",
    "browser": "src/main.ts",
    "keywords": ["zui:js-helpers"],
    "main": "src/main.ts",
    "files": [
        "./src/**/*"
    ],
    "zui": {
        "type": "js-helpers",
        "displayName": "Split.js",
        "contributes": {
            "js": [
                "module"
            ],
            "css": [
                "class",
                "var"
            ]
        }
    },
    "dependencies": {
        "@zui/core": "workspace:^3.1.0",
        "@zui/css-icons": "workspace:^3.1.0",
        "split.js": "^1.6.5"
    },
    "devDependencies": {
        "zui-dev": "workspace:^3.1.0",
        "@zui/button": "workspace:^3.1.0",
        "@zui/menu": "workspace:^3.1.0"
    }
}
