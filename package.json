{
  "name": "zui",
  "version": "3.0.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.13",
    "pnpm": "11.21.0"
  },
  "files": [
    "dist/zui"
  ],
  "main": "./dist/zui/zui.js",
  "module": "./dist/zui/zui.esm.js",
  "exports": {
    ".": {
      "import": "./dist/zui.esm.js",
      "require": "./dist/zui.js"
    },
    "./css": "./dist/zui.css"
  },
  "scripts": {
    "dev": "vite --host",
    "dev:exts": "tsx ./scripts/dev/index.ts",
    "build:vite": "tsc && vite build",
    "build": "tsx ./scripts/build",
    "preview": "vite preview",
    "preinstall": "npx only-allow pnpm",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run --project unit --project dom",
    "test:watch": "vitest --project unit --project dom",
    "test:coverage": "vitest run --coverage --project unit --project dom",
    "test:skills": "node --test skills/zui/scripts/inspect-zui-project.test.mjs",
    "test:build": "vitest run --project build",
    "test:e2e": "playwright test",
    "test:e2e:all": "tsx ./scripts/tests/e2e-all.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:skills",
    "docs:dev-fast": "cd docs && pnpm dev",
    "docs:dev": "pnpm docs:prepare -- --copy && pnpm docs:dev-fast & pnpm docs:watch",
    "docs:dev:exts": "pnpm docs:prepare -- --copy --exts --lib=zui*exts && pnpm docs:dev-fast & pnpm docs:watch -- --exts",
    "docs:watch": "tsx ./scripts/docs/watch.ts",
    "docs:build": "pnpm docs:prepare -- --copy --ignoreNotReady && cd docs && pnpm build",
    "docs:build:exts": "pnpm docs:prepare -- --copy --exts --lib=zui*exts && cd docs && pnpm build",
    "docs:serve": "cd docs && pnpm serve",
    "docs:prepare": "tsx ./scripts/docs/prepare.ts",
    "extend-lib": "tsx ./scripts/libs/extend-lib.ts",
    "lib:keywords": "tsx ./scripts/libs/check-keywords.ts",
    "publish:npm": "pnpm build -- --ignoreNotReady && tsx ./scripts/build/publish.ts && cd ./publish && npm publish"
  },
  "dependencies": {
    "@floating-ui/core": "^1.7.3",
    "@floating-ui/dom": "^1.7.4",
    "@floating-ui/utils": "^0.2.10",
    "@preact/signals": "^1.3.2",
    "@preact/signals-core": "^1.12.1",
    "@zui/base": "workspace:*",
    "@zui/scrollbar": "workspace:*",
    "@zui/typography": "workspace:*",
    "@zui/utilities": "workspace:*",
    "cash-dom": "^8.1.5",
    "dayjs": "^1.11.18",
    "htm": "^3.1.1",
    "nanoid": "^5.1.5",
    "preact": "^10.27.2",
    "tinykeys": "^2.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^8.4.1",
    "@mertasan/tailwindcss-variables": "^2.7.0",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@preact/preset-vite": "2.10.6",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/preact": "3.2.4",
    "@testing-library/user-event": "14.6.4",
    "@types/babel__core": "7.20.5",
    "@types/fs-extra": "^11.0.4",
    "@types/glob": "^8.1.0",
    "@types/jsdom": "30.0.0",
    "@types/markdown-it": "^13.0.9",
    "@types/minimist": "^1.2.5",
    "@types/node": "22.20.1",
    "@typescript-eslint/parser": "^8.68.0",
    "autoprefixer": "^10.4.21",
    "chokidar": "^3.6.0",
    "colorette": "^2.0.20",
    "cssnano": "^6.1.2",
    "eslint": "^10.9.1",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.2",
    "highlight.js": "^11.11.1",
    "jsdom": "30.0.1",
    "jquery": "^3.7.1",
    "markdown-it": "^13.0.2",
    "markdown-it-anchor": "^8.6.7",
    "markdown-it-toc-done-right": "^4.2.0",
    "minimist": "^1.2.8",
    "postcss": "^8.5.6",
    "postcss-import": "^15.1.0",
    "postcss-inset": "^1.0.0",
    "postcss-rem-to-pixel": "^4.1.2",
    "tailwindcss": "^3.4.17",
    "tsx": "4.23.12",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0",
    "vite": "7.3.6",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-zip-file": "^2.2.0",
    "vitest": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "zui-dev": "workspace:*"
  }
}
