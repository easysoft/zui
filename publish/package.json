{
    "name": "zui",
    "version": "3.0.0",
    "type": "module",
    "engines": {
      "node": ">=14",
      "pnpm": ">=8"
    },
    "files": ["dist"],
    "main": "./dist/zui.cjs",
    "module": "./dist/zui.esm.js",
    "types": "./dist/zui.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/zui.d.ts",
          "default": "./dist/zui.esm.js"
        },
        "require": {
          "types": "./dist/zui.d.cts",
          "default": "./dist/zui.cjs"
        }
      },
      "./css": {
        "types": "./dist/types/css.d.ts",
        "default": "./dist/zui.css"
      }
    },
    "dependencies": {
      "@floating-ui/dom": "^1.7.4",
      "@preact/signals": "^1.3.2",
      "@tanstack/query-core": "5.102.8",
      "@tanstack/virtual-core": "3.17.9",
      "@types/sortablejs": "^1.15.1",
      "@types/vhtml": "^2.2.9",
      "cash-dom": "^8.1.5",
      "htm": "^3.1.1",
      "preact": "^10.27.2",
      "split.js": "^1.6.5"
    },
    "devDependencies": {
    }
  }
